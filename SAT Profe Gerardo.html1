<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>El SAT del Profe Gerardo</title>
<style>
:root{
  --navy:#0E1B3D; --navy-deep:#0A1230;
  --gold:#B8863C; --gold-light:#F4DD7A;
  --teal:#2FC2AD; --coral:#EF6A5B;
  --ink:#20242B; --paper:#F3F5F4; --muted:#5B6470; --line:#D8DCDD;
  --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --mono: 'IBM Plex Mono', 'SFMono-Regular', Menlo, Consolas, monospace;
}
*{box-sizing:border-box;}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);padding-bottom:60px;}
.topbar{position:sticky;top:0;z-index:30;background:var(--navy);color:#fff;padding:12px 16px;box-shadow:0 2px 10px rgba(0,0,0,.18);}
.topbar-row{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;}
.topbar h1{font-size:15px;margin:0 0 2px;}
.topbar p{margin:0;font-size:10px;color:rgba(255,255,255,.65);font-family:var(--mono);letter-spacing:.4px;text-transform:uppercase;}
.badge-phase{background:var(--gold);color:var(--navy-deep);font-size:9.5px;font-family:var(--mono);font-weight:700;padding:3px 9px;border-radius:10px;text-transform:uppercase;letter-spacing:.4px;}

.namebar{background:#fff;border-bottom:1px solid var(--line);padding:9px 14px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
.namebar input{padding:7px 9px;border:1px solid var(--line);border-radius:6px;font-size:13px;flex:1;min-width:160px;}
.namebar input:disabled{background:#f7f8f6;color:var(--navy);font-weight:600;border-color:var(--teal);}
.namebar label{font-size:11px;color:var(--muted);font-family:var(--mono);}
.namebar.verified{background:#e7f1ec;}
.namebar .verified-tag{font-size:10.5px;color:var(--teal);font-family:var(--mono);font-weight:700;}

.page{max-width:760px;margin:0 auto;padding:16px;}
.intro-card{background:#fff;border:1px solid var(--line);border-left:4px solid var(--gold);border-radius:8px;padding:16px 18px;margin-bottom:18px;font-size:13px;line-height:1.6;color:var(--ink);}
.intro-card h2{font-size:16px;margin:0 0 8px;color:var(--navy);}

.section-title{font-size:13.5px;font-weight:700;color:var(--navy);margin:20px 0 10px;display:flex;align-items:center;gap:8px;}
.section-title .line{flex:1;height:1px;background:var(--line);}

.empresa-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;}
@media (max-width:520px){.empresa-grid{grid-template-columns:1fr;}}
.empresa-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px;cursor:pointer;transition:border-color .15s;position:relative;}
.empresa-card:hover{border-color:var(--gold);}
.empresa-card.active{border-color:var(--teal);box-shadow:0 0 0 1px var(--teal) inset;}
.empresa-card .ec-name{font-weight:700;color:var(--navy);font-size:13.5px;margin-bottom:3px;padding-right:22px;}
.empresa-card .ec-sector{font-size:10.5px;color:var(--muted);font-family:var(--mono);text-transform:uppercase;}
.empresa-card .ec-cedula{font-size:10px;color:var(--muted);font-family:var(--mono);margin-top:2px;}
.empresa-card .ec-date{font-size:10px;color:var(--muted);margin-top:6px;}
.empresa-card .ec-delete{position:absolute;top:10px;right:10px;font-size:15px;color:var(--muted);cursor:pointer;line-height:1;padding:2px 4px;border-radius:4px;}
.empresa-card .ec-delete:hover{color:var(--coral);background:#f7e9e8;}

.new-empresa-card{background:#f7f8f6;border:1px dashed var(--line);border-radius:10px;padding:14px;text-align:center;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);font-size:12.5px;min-height:90px;}
.new-empresa-card:hover{border-color:var(--gold);color:var(--gold);}
.new-empresa-card .plus{font-size:24px;margin-bottom:4px;}

.form-card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:16px;margin-bottom:16px;}
.form-card h3{font-size:13.5px;margin:0 0 10px;color:var(--navy);}
.form-row{margin-bottom:12px;}
.form-row label{display:block;font-size:11.5px;color:var(--muted);margin-bottom:4px;font-family:var(--mono);text-transform:uppercase;}
.form-row input, .form-row select{width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:6px;font-size:13px;font-family:var(--sans);}
.btn{display:inline-block;padding:9px 18px;background:var(--navy);color:#fff;border:none;border-radius:20px;font-size:12.5px;font-weight:600;cursor:pointer;}
.btn:hover{background:var(--navy-deep);}
.btn:disabled{opacity:.45;cursor:default;}
.btn.secondary{background:#fff;color:var(--navy);border:1px solid var(--navy);}
.btn-row{display:flex;gap:8px;}

.catalogo-header{background:linear-gradient(135deg,var(--navy) 0%,var(--navy-deep) 100%);color:#fff;border-radius:10px;padding:16px 18px;margin-bottom:14px;}
.catalogo-header .ch-label{font-family:var(--mono);font-size:10px;color:var(--gold-light);text-transform:uppercase;letter-spacing:1px;}
.catalogo-header h2{margin:6px 0 2px;font-size:17px;}
.catalogo-header p{margin:0;font-size:11.5px;color:rgba(255,255,255,.7);}

.informe-header{background:#fff;border:2px solid var(--navy);border-radius:10px;padding:16px 18px;margin-bottom:14px;text-align:center;}
.informe-header .ih-empresa{font-size:15px;font-weight:800;color:var(--navy);margin:0 0 2px;}
.informe-header .ih-cedula{font-size:11px;color:var(--muted);font-family:var(--mono);margin:0 0 8px;}
.informe-header .ih-titulo{font-size:12.5px;font-weight:700;color:var(--gold);text-transform:uppercase;letter-spacing:.5px;margin:8px 0 2px;padding-top:8px;border-top:1px dashed var(--line);}
.informe-header .ih-fecha{font-size:10.5px;color:var(--muted);font-family:var(--mono);}

.cat-group{background:#fff;border:1px solid var(--line);border-radius:10px;margin-bottom:12px;overflow:hidden;}
.cat-group-head{padding:10px 14px;font-size:12.5px;font-weight:700;color:#fff;display:flex;justify-content:space-between;align-items:center;}
.cat-group-head .count{font-family:var(--mono);font-size:11px;font-weight:400;opacity:.85;}
.cat-table{width:100%;border-collapse:collapse;}
.cat-table td{padding:8px 14px;font-size:12px;border-top:1px solid var(--line);}
.cat-table td.code{font-family:var(--mono);color:var(--muted);width:60px;}
.cat-table td.nature{font-family:var(--mono);font-size:10px;text-align:right;width:80px;}
.nature.deudora{color:#1e7a63;}
.nature.acreedora{color:#a3541e;}

.empty-state{text-align:center;color:var(--muted);font-size:12.5px;padding:30px 20px;background:#fff;border:1px dashed var(--line);border-radius:8px;}
.footer-note{font-size:11px;color:var(--muted);text-align:center;margin-top:20px;}
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-row">
    <div>
      <h1>🏛️ El SAT del Profe Gerardo</h1>
      <p>Simulador contable · Contabilidad</p>
    </div>
    <span class="badge-phase">Fase 1: Empresas y Catálogo</span>
  </div>
</div>

<div class="namebar" id="namebar">
  <label>Tu nombre:</label>
  <input type="text" id="studentName" placeholder="Nombre completo" maxlength="45">
  <span id="nameStatus" style="font-size:11px;color:var(--muted);font-family:var(--mono);"></span>
</div>

<div class="page" id="page">
  <div class="intro-card">
    <h2>Bienvenido a tu simulador contable</h2>
    <p>Acá vas a crear tus propias empresas y llevar su contabilidad completa: catálogo de cuentas, registro de facturas, asientos de diario, mayorización y estados financieros. Iremos agregando partes conforme avancemos en el curso.</p>
    <p style="margin:0;color:var(--muted);">Por ahora: escribí tu nombre arriba, y creá tu primera empresa.</p>
  </div>

  <div class="section-title"><span>📂 Mis empresas</span><span class="line"></span></div>
  <div class="empresa-grid" id="empresaGrid"></div>

  <div id="formArea"></div>
  <div id="catalogoArea"></div>
</div>

<script>
/* ============================================================
   CONEXIÓN A GOOGLE SHEETS
   ============================================================ */
const SHEET_API_URL = "https://script.google.com/macros/s/AKfycbzMGf_Gpf6UWswFPSqEBMdq-93GxGkrURsT4jtO9Jaz8yT5gyMMtp1btlcDZjRCeuAb/exec";
function sheetsReady(){ return SHEET_API_URL && !SHEET_API_URL.startsWith('REEMPLAZAR'); }

let jsonpCounter = 0;
function jsonpRequest(url){
  return new Promise((resolve, reject)=>{
    const cbName = 'jsonp_cb_' + (jsonpCounter++) + '_' + Date.now();
    const script = document.createElement('script');
    let settled = false;
    const cleanup = ()=>{ delete window[cbName]; if(script.parentNode) script.parentNode.removeChild(script); };
    window[cbName] = (data)=>{ settled = true; cleanup(); resolve(data); };
    script.onerror = ()=>{ if(!settled){ cleanup(); reject(new Error('Error de red')); } };
    script.src = url + (url.includes('?') ? '&' : '?') + 'callback=' + cbName;
    document.body.appendChild(script);
    setTimeout(()=>{ if(!settled){ cleanup(); reject(new Error('Tiempo de espera agotado')); } }, 10000);
  });
}
async function sheetGet(sheetName){
  const data = await jsonpRequest(SHEET_API_URL + '?sheet=' + encodeURIComponent(sheetName));
  return data.rows || [];
}
async function sheetPost(sheetName, row){
  await fetch(SHEET_API_URL, { method:'POST', mode:'no-cors', body: JSON.stringify({ sheet: sheetName, row }) });
  return { ok:true };
}
function escapeHtml(s){ return (s+"").replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function genId(){ return 'emp_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2,7); }

/* ============================================================
   ENCABEZADO FORMAL DE INFORMES
   Reutilizable para todo informe generado por el sistema:
   catálogo, asientos, mayor, estados financieros, etc.
   ============================================================ */
function renderInformeHeader(empresa, tituloInforme){
  const fechaHoy = new Date().toLocaleDateString('es-CR', { day:'2-digit', month:'long', year:'numeric' });
  return `
    <div class="informe-header">
      <div class="ih-empresa">${escapeHtml(empresa.NombreEmpresa)}</div>
      <div class="ih-cedula">Cédula Jurídica: ${escapeHtml(empresa.CedulaJuridica || 'No registrada')}</div>
      <div class="ih-titulo">${escapeHtml(tituloInforme)}</div>
      <div class="ih-fecha">Emitido el ${fechaHoy}</div>
    </div>
  `;
}

/* ============================================================
