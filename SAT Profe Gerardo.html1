/* ============================================================
   ESTADO
   ============================================================ */
let studentName = "";
let misEmpresas = [];
let empresaActiva = null;

const empresaGrid = document.getElementById('empresaGrid');
const formArea = document.getElementById('formArea');
const catalogoArea = document.getElementById('catalogoArea');

/* ============================================================
   CARGA DE EMPRESAS DEL ESTUDIANTE
   ============================================================ */
let empresasEliminadasIds = [];

async function loadMisEmpresas(){
  if(!studentName || !sheetsReady()){ renderEmpresaGrid(); return; }
  empresaGrid.innerHTML = '<p style="color:var(--muted);font-size:12px;">Cargando tus empresas...</p>';
  try{
    const [rows, eliminadas] = await Promise.all([
      sheetGet('SAT_Empresas'),
      sheetGet('SAT_EmpresasEliminadas')
    ]);
    empresasEliminadasIds = eliminadas.filter(r => r.Estudiante === studentName).map(r => r.EmpresaId);
    misEmpresas = rows.filter(r => r.Estudiante === studentName && !empresasEliminadasIds.includes(r.EmpresaId));
  }catch(e){
    misEmpresas = [];
  }
  renderEmpresaGrid();
}

function renderEmpresaGrid(){
  empresaGrid.innerHTML = '';

  if(!studentName){
    empresaGrid.innerHTML = '<div class="empty-state">Escribí tu nombre arriba para ver o crear tus empresas.</div>';
    return;
  }

  misEmpresas.forEach(emp=>{
    const card = document.createElement('div');
    card.className = 'empresa-card' + (empresaActiva && empresaActiva.EmpresaId===emp.EmpresaId ? ' active' : '');
    const fecha = emp.Timestamp ? new Date(emp.Timestamp).toLocaleDateString('es-CR') : '';
    card.innerHTML = `
      <span class="ec-delete" title="Eliminar empresa">🗑️</span>
      <div class="ec-name">🏢 ${escapeHtml(emp.NombreEmpresa)}</div>
      <div class="ec-sector">${escapeHtml(emp.Sector || 'Comercial')}</div>
      <div class="ec-cedula">Céd. Jurídica: ${escapeHtml(emp.CedulaJuridica || '—')}</div>
      <div class="ec-date">Creada: ${fecha}</div>
    `;
    card.addEventListener('click', ()=>{
      empresaActiva = emp;
      formArea.innerHTML = '';
      renderEmpresaGrid();
      renderCatalogo();
    });
    card.querySelector('.ec-delete').addEventListener('click', async (e)=>{
      e.stopPropagation();
      if(!confirm(`¿Eliminar la empresa "${emp.NombreEmpresa}"? Esta acción no se puede deshacer.`)) return;
      try{
        const nowIso = new Date().toISOString();
        await sheetPost('SAT_EmpresasEliminadas', [nowIso, studentName, emp.EmpresaId]);
        misEmpresas = misEmpresas.filter(m => m.EmpresaId !== emp.EmpresaId);
        if(empresaActiva && empresaActiva.EmpresaId === emp.EmpresaId){
          empresaActiva = null;
          catalogoArea.innerHTML = '';
        }
        renderEmpresaGrid();
      }catch(err){
        alert('No se pudo eliminar la empresa. Revisá la conexión a la hoja de datos.');
      }
    });
    empresaGrid.appendChild(card);
  });

  const newCard = document.createElement('div');
  newCard.className = 'new-empresa-card';
  newCard.innerHTML = `<div class="plus">➕</div><div>Crear nueva empresa</div>`;
  newCard.addEventListener('click', renderNuevaEmpresaForm);
  empresaGrid.appendChild(newCard);
}

/* ============================================================
   FORMULARIO: NUEVA EMPRESA
   ============================================================ */
function renderNuevaEmpresaForm(){
  if(!studentName){ alert('Escribí tu nombre arriba antes de crear una empresa.'); return; }
  catalogoArea.innerHTML = '';
  empresaActiva = null;
  renderEmpresaGrid();

  formArea.innerHTML = `
    <div class="form-card">
      <h3>➕ Crear nueva empresa</h3>
      <div class="form-row">
        <label>Nombre de la empresa</label>
        <input type="text" id="newEmpresaName" placeholder="Ej: Comercial El Roble S.A.">
      </div>
      <div class="form-row">
        <label>Cédula Jurídica</label>
        <input type="text" id="newEmpresaCedula" placeholder="Ej: 3-101-123456" inputmode="numeric">
      </div>
      <div class="form-row">
        <label>Sector</label>
        <select id="newEmpresaSector">
          <option value="Comercial">Comercial (compra-venta de mercancías)</option>
          <option value="Servicios">Servicios (empresa que presta servicios)</option>
          <option value="Industrial">Industrial (empresa que fabrica productos)</option>
        </select>
      </div>
      <div class="btn-row">
        <button class="btn" id="createEmpresaBtn">Crear empresa</button>
        <button class="btn secondary" id="cancelEmpresaBtn">Cancelar</button>
      </div>
      <p style="font-size:10.5px;color:var(--muted);margin-top:10px;margin-bottom:0;">La empresa se crea con el catálogo de cuentas estándar según el sector elegido. Luego podés agregar cuentas adicionales si lo necesitás.</p>
    </div>
  `;

  document.getElementById('cancelEmpresaBtn').addEventListener('click', ()=>{ formArea.innerHTML=''; });

  document.getElementById('createEmpresaBtn').addEventListener('click', async ()=>{
    const nombre = document.getElementById('newEmpresaName').value.trim();
    const cedulaJuridica = document.getElementById('newEmpresaCedula').value.trim();
    const sector = document.getElementById('newEmpresaSector').value;
    if(!nombre){ alert('Escribí un nombre para la empresa.'); return; }
    if(!cedulaJuridica){ alert('Escribí la cédula jurídica de la empresa — es parte del procedimiento formal.'); return; }

    const btn = document.getElementById('createEmpresaBtn');
    btn.disabled = true;
    btn.textContent = 'Creando...';

    const empresaId = genId();
    const nowIso = new Date().toISOString();
    const nuevaEmpresa = { Timestamp: nowIso, Estudiante: studentName, EmpresaId: empresaId, NombreEmpresa: nombre, Sector: sector, CedulaJuridica: cedulaJuridica };

    try{
      await sheetPost('SAT_Empresas', [nowIso, studentName, empresaId, nombre, sector, cedulaJuridica]);
      misEmpresas.push(nuevaEmpresa);
      empresaActiva = nuevaEmpresa;
      formArea.innerHTML = '';
      renderEmpresaGrid();
      renderCatalogo();
    }catch(e){
      alert('No se pudo crear la empresa. Revisá la conexión a la hoja de datos.');
      btn.disabled = false;
      btn.textContent = 'Crear empresa';
    }
  });
}

/* ============================================================
   CATÁLOGO DE CUENTAS (estándar por sector + personalizadas)
   ============================================================ */
let cuentasPersonalizadas = [];

async function renderCatalogo(){
  if(!empresaActiva){ catalogoArea.innerHTML = ''; return; }

  catalogoArea.innerHTML = '<p style="color:var(--muted);font-size:12px;">Cargando catálogo...</p>';

  cuentasPersonalizadas = [];
  if(sheetsReady()){
    try{
      const rows = await sheetGet('SAT_CuentasPersonalizadas');
      cuentasPersonalizadas = rows.filter(r => r.EmpresaId === empresaActiva.EmpresaId);
    }catch(e){}
  }

  const sector = empresaActiva.Sector || 'Comercial';
  const catalogoBase = CATALOGOS_POR_SECTOR[sector] || CATALOGOS_POR_SECTOR['Comercial'];

  // combinar catalogo estandar + personalizadas, agrupadas por Tipo
  const grupos = {};
  Object.entries(catalogoBase).forEach(([grupo, data])=>{
    grupos[grupo] = { color:data.color, cuentas: [...data.cuentas] };
  });
  cuentasPersonalizadas.forEach(c=>{
    const tipo = c.Tipo || 'Gasto';
    if(!grupos[tipo]) grupos[tipo] = { color:'#5B6470', cuentas:[] };
    grupos[tipo].cuentas.push({ codigo:c.Codigo, nombre:c.Nombre, naturaleza:c.Naturaleza, personalizada:true });
  });

  let totalCuentas = 0;
  Object.values(grupos).forEach(g=>totalCuentas+=g.cuentas.length);

  let html = renderInformeHeader(empresaActiva, 'Catálogo de Cuentas');
  html += `
    <div class="catalogo-header">
      <div class="ch-label">Catálogo de Cuentas</div>
      <h2>🏢 ${escapeHtml(empresaActiva.NombreEmpresa)}</h2>
      <p>Sector: ${escapeHtml(sector)} · ${totalCuentas} cuentas${cuentasPersonalizadas.length ? ' (' + cuentasPersonalizadas.length + ' agregadas por vos)' : ''}</p>
    </div>
  `;

  const ORDEN_GRUPOS = ["Activo","Pasivo","Patrimonio","Ingreso","Costo","Gasto"];
  ORDEN_GRUPOS.filter(g=>grupos[g]).forEach(grupo=>{
    const data = grupos[grupo];
    let rows = '';
    data.cuentas.forEach(c=>{
      const natClass = c.naturaleza === 'Deudora' ? 'deudora' : 'acreedora';
      const tag = c.personalizada ? ' <span style="font-size:9px;color:var(--gold);font-family:var(--mono);">· agregada</span>' : '';
      rows += `<tr><td class="code">${escapeHtml(c.codigo)}</td><td>${escapeHtml(c.nombre)}${tag}</td><td class="nature ${natClass}">${c.naturaleza}</td></tr>`;
    });
    html += `
      <div class="cat-group">
        <div class="cat-group-head" style="background:${data.color};">
          <span>${grupo}</span><span class="count">${data.cuentas.length} cuentas</span>
        </div>
        <table class="cat-table"><tbody>${rows}</tbody></table>
      </div>
    `;
  });

  html += `
    <div class="form-card" id="addCuentaCard">
      <h3>➕ Agregar cuenta al catálogo</h3>
      <div class="form-row">
        <label>Código</label>
        <input type="text" id="newCuentaCodigo" placeholder="Ej: 1108" inputmode="numeric">
      </div>
      <div class="form-row">
        <label>Nombre de la cuenta</label>
        <input type="text" id="newCuentaNombre" placeholder="Ej: Anticipo de Clientes">
      </div>
      <div class="form-row">
        <label>Grupo</label>
        <select id="newCuentaTipo">
          <option value="Activo">Activo</option>
          <option value="Pasivo">Pasivo</option>
          <option value="Patrimonio">Patrimonio</option>
          <option value="Ingreso">Ingreso</option>
          <option value="Costo">Costo</option>
          <option value="Gasto">Gasto</option>
        </select>
      </div>
      <div class="form-row">
        <label>Naturaleza</label>
        <select id="newCuentaNaturaleza">
          <option value="Deudora">Deudora</option>
          <option value="Acreedora">Acreedora</option>
        </select>
      </div>
      <button class="btn" id="addCuentaBtn">Agregar cuenta</button>
    </div>
  `;

  html += `<p class="footer-note">Próximamente: registro de facturas, asientos de diario, mayorización y estados financieros para esta empresa.</p>`;

  catalogoArea.innerHTML = html;

  document.getElementById('addCuentaBtn').addEventListener('click', async ()=>{
    const codigo = document.getElementById('newCuentaCodigo').value.trim();
    const nombre = document.getElementById('newCuentaNombre').value.trim();
    const tipo = document.getElementById('newCuentaTipo').value;
    const naturaleza = document.getElementById('newCuentaNaturaleza').value;
    if(!codigo || !nombre){ alert('Completá el código y el nombre de la cuenta.'); return; }

    const btn = document.getElementById('addCuentaBtn');
    btn.disabled = true;
    btn.textContent = 'Agregando...';

    try{
      const nowIso = new Date().toISOString();
      await sheetPost('SAT_CuentasPersonalizadas', [nowIso, empresaActiva.EmpresaId, codigo, nombre, tipo, naturaleza]);
      await renderCatalogo();
    }catch(e){
      alert('No se pudo agregar la cuenta. Revisá la conexión a la hoja de datos.');
      btn.disabled = false;
      btn.textContent = 'Agregar cuenta';
    }
  });
}


/* ============================================================
   NOMBRE DEL ESTUDIANTE
   ============================================================ */
document.getElementById('studentName').addEventListener('input', function(){
  studentName = this.value.trim();
  document.getElementById('nameStatus').textContent = studentName ? '● identificado' : '';
});
document.getElementById('studentName').addEventListener('change', function(){
  empresaActiva = null;
  formArea.innerHTML = '';
  catalogoArea.innerHTML = '';
  if(studentName) loadMisEmpresas();
});

(function prefillFromLink(){
  const params = new URLSearchParams(window.location.search);
  const nombreParam = params.get('nombre');
  if(nombreParam){
    studentName = nombreParam;
    const input = document.getElementById('studentName');
    input.value = nombreParam;
    input.disabled = true;
    document.getElementById('namebar').classList.add('verified');
    document.getElementById('nameStatus').innerHTML = '<span class="verified-tag">✓ Verificado desde tu perfil</span>';
    loadMisEmpresas();
  }
})();

renderEmpresaGrid();
</script>
</body>
</html>
